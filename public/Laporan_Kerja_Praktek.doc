<tr><th>Field</th><th>Tipe Data</th><th>Keterangan</th><th>Atribut</th></tr>
<tr><td>id</td><td>String</td><td>Primary Key</td><td>@id, @default(cuid())</td></tr>
<tr><td>name</td><td>String</td><td>Nama Sektor Bisnis</td><td></td></tr>
<tr><td>description</td><td>String</td><td>Penjelasan sektor</td><td></td></tr>
<tr><td>imageUrl</td><td>String?</td><td>Tautan gambar/ikon ilustrasi</td><td></td></tr>
<tr><td>order</td><td>Int</td><td>Urutan penempatan</td><td>@default(0)</td></tr>
</table>

<h4>4. Tabel <code>Team</code> & <code>Member</code></h4>
