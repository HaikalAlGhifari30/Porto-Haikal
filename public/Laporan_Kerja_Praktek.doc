<tr><td>2</td><td>RAM</td><td>4 GB</td><td>8 GB atau 16 GB</td></tr>
<tr><td>3</td><td>Penyimpanan (Storage)</td><td>256 GB SSD</td><td>512 GB SSD</td></tr>
<tr><td>4</td><td>Layar / Monitor</td><td>Resolusi 1366x768</td><td>Resolusi 1920x1080 (FHD)</td></tr>
<tr><td>5</td><td>Koneksi Internet</td><td>Stabil (Minimal 10 Mbps)</td><td>Wi-Fi / LAN</td></tr>
</table>

