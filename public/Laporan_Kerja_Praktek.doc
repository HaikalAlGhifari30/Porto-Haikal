<tr><th>No</th><th>Perangkat Lunak</th><th>Kegunaan</th></tr>
<tr><td>1</td><td>Sistem Operasi</td><td>Windows 10 / Windows 11 / macOS</td></tr>
<tr><td>2</td><td>Code Editor</td><td>Visual Studio Code (VS Code)</td></tr>
<tr><td>3</td><td>Web Browser</td><td>Google Chrome / Mozilla Firefox</td></tr>
