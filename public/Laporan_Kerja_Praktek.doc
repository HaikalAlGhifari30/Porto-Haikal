<tr><td>name</td><td>String</td><td>Nama Lengkap Karyawan</td><td></td></tr>
<tr><td>photo</td><td>String?</td><td>Tautan foto profil</td><td></td></tr>
<tr><td>teamId</td><td>String</td><td>Relasi ke Tabel Team</td><td>Foreign Key</td></tr>
