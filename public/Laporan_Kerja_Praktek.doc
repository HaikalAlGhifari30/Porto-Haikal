<tr><th>Field</th><th>Tipe Data</th><th>Keterangan</th><th>Atribut</th></tr>
<tr><td>id</td><td>String</td><td>Primary Key</td><td>@id, @default(cuid())</td></tr>
<tr><td>heroTitle</td><td>String</td><td>Judul utama beranda</td><td></td></tr>
<tr><td>heroSubtitle</td><td>String</td><td>Subjudul beranda</td><td></td></tr>
<tr><td>heroBannerUrl</td><td>String?</td><td>URL gambar latar belakang</td><td></td></tr>
<tr><td>aboutText</td><td>String?</td><td>Teks profil perusahaan</td><td></td></tr>
<tr><td>visionText</td><td>String?</td><td>Teks Visi</td><td></td></tr>
<tr><td>missionText</td><td>String?</td><td>Teks Misi</td><td></td></tr>
<tr><td>email</td><td>String?</td><td>Kontak Email publik</td><td></td></tr>
<tr><td>phone</td><td>String?</td><td>Kontak Telepon publik</td><td></td></tr>
<tr><td>address</td><td>String?</td><td>Alamat kantor</td><td></td></tr>
</table>

<h4>3. Tabel <code>BusinessSector</code> (Bidang Usaha)</h4>
